{
  "env": {
    "name": "piper",
    "type": "piper",
    "task": "pick up the red block and place in blue bin",
    "fps": 30,
    "processor": {
      "control_mode": "keyboard",
      "max_gripper_pos": 0.04,
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "reset_time_s": 3.0,
        "control_time_s": 20.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "target_frame_name": "ee",
        "end_effector_bounds": {
          "min": [0.15, -0.30, 0.12],
          "max": [0.55, 0.30, 0.45]
        },
        "end_effector_step_sizes": {
          "x": 0.015,
          "y": 0.015,
          "z": 0.015
        }
      },
      "reward_classifier": {
        "pretrained_path": "outputs/reward_classifier",
        "success_threshold": 0.5,
        "success_reward": 1.0
      }
    }
  },
  "dataset": {
    "repo_id": "local/piper_hilserl_demos",
    "task": "pick up the red block and place in blue bin",
    "root": "data/piper_hilserl_demos",
    "num_episodes_to_record": 10,
    "push_to_hub": false
  },
  "device": "cpu"
}

